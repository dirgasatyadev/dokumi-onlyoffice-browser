{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dokumi-onlyoffice-browser",
  "compatibility_date": "2026-07-31",
  "main": "src/deploy-worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/releases/0.1.0/x2t/x2t.wasm"]
  },
  "routes": [
    { "pattern": "editor.office.dokumi.id", "custom_domain": true }
  ]
}
