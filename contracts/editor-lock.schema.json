{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office.dokumi.id/contracts/editor-lock.schema.json",
  "title": "Dokumi browser editor distribution lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "artifact"],
  "properties": {
    "$schema": { "type": "string" },
    "lockVersion": { "const": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceRepository", "sourceCommit", "sourceArchiveUrl", "sourceArchiveFile", "sourceArchiveBytes", "sourceArchiveSha256", "releaseTag", "downloadUrl", "archiveFile", "archiveBytes", "sha256", "sha512", "criticalFiles"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sourceRepository": { "const": "https://github.com/cryptpad/onlyoffice-editor.git" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceArchiveUrl": { "type": "string", "pattern": "^https://codeload\\.github\\.com/cryptpad/onlyoffice-editor/tar\\.gz/[0-9a-f]{40}$" },
        "sourceArchiveFile": { "type": "string", "pattern": "^onlyoffice-editor-[0-9a-f]{40}\\.tar\\.gz$" },
        "sourceArchiveBytes": { "type": "integer", "minimum": 1 },
        "sourceArchiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "releaseTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+\\+0$" },
        "downloadUrl": { "type": "string", "pattern": "^https://github\\.com/cryptpad/onlyoffice-editor/releases/download/" },
        "archiveFile": { "type": "string", "pattern": "^[a-zA-Z0-9.+-]+\\.zip$" },
        "archiveBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "criticalFiles": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
