{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office.dokumi.id/contracts/artifacts-lock.schema.json",
  "title": "Dokumi ONLYOFFICE binary artifact lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "lockVersion": { "const": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourceRepository", "sourceCommit", "releaseTag", "downloadUrl", "archiveFile", "archiveBytes", "sha256", "files"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sourceRepository": { "type": "string", "format": "uri" },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "releaseTag": { "type": "string", "minLength": 1 },
          "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/cryptpad/onlyoffice-x2t-wasm/releases/download/" },
          "archiveFile": { "type": "string", "pattern": "^[a-zA-Z0-9.+-]+\\.zip$" },
          "archiveBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "bytes", "sha256"],
              "properties": {
                "path": { "enum": ["x2t.js", "x2t.wasm"] },
                "bytes": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
